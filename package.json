{
  "name": "n-seo",
  "version": "0.2.0",
  "description": "Agentic, local-first SEO / AEO / GEO control plane: pulls Search Console + GA4, probes your sites, and ranks the next moves. Your LLM writes the proposals; your coding agent works the queue over MCP.",
  "license": "MIT",
  "author": "En Dash Consulting (https://endash.us)",
  "homepage": "https://n-seo.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/en-dash-consulting/n-seo.git"
  },
  "bugs": {
    "url": "https://github.com/en-dash-consulting/n-seo/issues"
  },
  "keywords": [
    "seo",
    "aeo",
    "geo",
    "agent",
    "ai-agent",
    "agentic",
    "llm",
    "claude",
    "claude-code",
    "mcp",
    "mcp-server",
    "search-console",
    "google-analytics",
    "ga4",
    "llms-txt",
    "ai-crawlers",
    "dashboard",
    "local-first",
    "cli"
  ],
  "type": "module",
  "bin": {
    "n-seo": "bin/n-seo.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "tsconfig.json",
    "ingest/",
    "ops/",
    "probes/",
    "public/",
    "n-seo.config.example.json",
    ".env.example",
    ".claude/skills/orient/",
    ".claude/skills/n-seo-setup/",
    ".claude/skills/n-seo-add-site/",
    ".claude/skills/n-seo-triage/",
    ".claude/skills/n-seo-ship/",
    ".claude/skills/n-seo-review/",
    ".claude/skills/n-seo-deploy/",
    "!.claude/skills/README.md",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.tsx",
    "start": "tsx src/server.tsx",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx src/mcp-stdio.ts",
    "mcp:smoke": "node ops/mcp-smoke-stdio.mjs",
    "doctor": "node ops/py.mjs ops/doctor.py",
    "demo": "node ops/py.mjs ops/demo_data.py",
    "daily": "node ops/py.mjs ops/daily.py",
    "test": "tsx --test tests/ts/*.test.ts",
    "test:py": "node ops/py.mjs -m unittest discover -s tests/py -v",
    "check": "npm run typecheck && npm test && npm run test:py",
    "export": "node ops/py.mjs ops/export_static.py",
    "docker:build": "docker build -t n-seo:latest .",
    "docker:up": "docker compose -f docker/compose.yml up -d"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.6.14",
    "tsx": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
