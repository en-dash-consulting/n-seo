# machine-refreshed snapshots — regenerable, never committed
data/
site/
__pycache__/
node_modules/

# secrets
.env
*.key.json
service-account*.json

# your live config is yours; the example ships with the repo
n-seo.config.json

# n-dx tool artifacts: regenerated caches and run logs, not source
.hench/
.sourcevision/
.rex/n-dx_workflow.md
.rex/execution-log*.jsonl
.rex/.backups/
.n-dx.local.json
claude_commands.log

# Generated at deploy time by .github/scripts/build-releases.mjs, so it can
# never drift from CHANGELOG.md.
www/releases/

# A real export of the dashboard, rebuilt at deploy time from the commit
# being deployed.
www/demo/

# macOS Finder metadata
.DS_Store
